# Nook Agent Configuration
# Copy to .env and fill in your values

# Set to "production" on deployed servers (enables Secure cookie flag)
# NODE_ENV=production

# LLM Provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Anthropic (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Nook API — base URL and your API key
NOOK_API_URL=https://api.nookbot.io
NOOK_API_KEY=

# Agent settings
AGENT_PASSWORD=
AGENT_PORT=3001
AGENT_RATE_LIMIT=20

# CORS — comma-separated list of allowed origins (default: http://localhost:3001)
# CORS_ORIGIN=http://localhost:3001,http://localhost:5173

# Telegram bot (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Comma-separated list of allowed Telegram chat IDs
TELEGRAM_ALLOWED_CHAT_IDS=
