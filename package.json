{
  "name": "nook-agent",
  "version": "1.1.0",
  "description": "Open-source AI chat assistant for Solana - uses LLM tool calling to query real-time blockchain data via the Nook API",
  "repository": {
    "type": "git",
    "url": "https://github.com/nookbot-io/nook.git"
  },
  "homepage": "https://nookbot.io",
  "bugs": "https://github.com/nookbot-io/nook/issues",
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "build:frontend": "cd frontend && npm install && npm run build",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "keywords": [
    "solana",
    "ai-agent",
    "llm",
    "tool-calling",
    "openai",
    "anthropic",
    "telegram-bot",
    "blockchain"
  ],
  "author": "Nook Contributors",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "axios": "^1.7.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "openai": "^4.77.0"
  }
}
